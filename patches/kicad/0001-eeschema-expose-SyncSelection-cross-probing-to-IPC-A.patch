+syntax = "proto3";
+
+package kiapi.common.commands;
+
+import "common/types/base_types.proto";
+
+enum CrossProbeStatus
+{
+  CPS_UNSPECIFIED = 0;
+  CPS_OK          = 1;
+  CPS_NOT_FOUND   = 2;
+  CPS_INVALID     = 3;
+  CPS_DISABLED    = 4;
+}
+
+// Internal KiCad API; may be removed without notice.
+// When running in standalone, the first frame to start will get the well-known API socket path.
+// Others can use this to set up a bidirectional link.  Since we don't plan to keep standalone
+// mode around for the long-term, this is a temporary workaround that doesn't change the whole
+// paradigm of the API away from client-server.
+message CrossProbeAnnounce
+{
+  kiapi.common.types.FrameType frame_type = 1;
+  string socket_path = 2;
+  string api_token = 3;
+}
+
+// Internal KiCad API; may be removed without notice.
+message CrossProbeAnnounceResponse
+{
+  CrossProbeStatus status  = 1;
+  string message = 2;
+}
+
+message FootprintSelectionSpec
+{
+  string reference = 1;
+}
+
+message PadSelectionSpec
+{
+  // Parent footprint
+  string reference = 1;
+  string number = 2;
+}
+
+message SelectionSpec
+{
+  oneof spec {
+    FootprintSelectionSpec footprint = 1;
+    PadSelectionSpec pad = 2;
+    kiapi.common.types.SheetPath sheet_path = 3;
+  }
+}
+
+enum SyncSelectionMode
+{
+  SSM_UNKNOWN = 0;
+  SSM_ITEMS_ONLY = 1;
+  SSM_ITEMS_AND_NETS = 2;
+}
+
+enum SyncSelectionContext
+{
+  SSC_UNKNOWN = 0;
+
+  // Implicit user action (e.g. just clicking on an item)
+  SSC_IMPLICIT = 1;
+
+  // Explicit user action (e.g. running a "select in other window" action)
+  SSC_EXPLICIT = 2;
+}
+
+message SyncSelection
+{
+  SyncSelectionContext context = 1;
+  SyncSelectionMode mode = 2;
+  SelectionSpec focus_item = 3;
+  repeated SelectionSpec items = 4;
+}
+
+message SyncSelectionResponse
+{
+  CrossProbeStatus status = 1;
+  string message = 2;
+}
+
+message HighlightNets
+{
+  repeated string net_name = 1;
+}
+
+message HighlightNetsResponse
+{
+  CrossProbeStatus status  = 1;
+  string message = 2;
+}
+
+message FocusOnItem
+{
+  SelectionSpec focus_item = 1;
+}
+
+message FocusOnItemResponse
+{
+  CrossProbeStatus status  = 1;
+  string message = 2;
+}
