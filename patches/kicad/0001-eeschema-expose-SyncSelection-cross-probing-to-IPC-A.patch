+
+HANDLER_RESULT<SyncSelectionResponse> API_HANDLER_SCH::handleSyncSelection(
+        const HANDLER_CONTEXT<SyncSelection>& aCtx )
+{
+    // Cross-probing from an API client: the same thing the PCB editor's
+    // "Select on Schematic" does, driven over IPC.  Reuses the frame's
+    // MAIL_SELECTION_FORCE machinery, so sheet switching, centring and
+    // flashing all follow the user's cross-probing preferences.
+    SyncSelectionResponse response;
+
+    const CROSS_PROBING_SETTINGS& settings = m_frame->eeconfig()->m_CrossProbing;
+
+    if( !settings.on_selection && aCtx.Request.context() != SyncSelectionContext::SSC_EXPLICIT )
+    {
+        response.set_status( CrossProbeStatus::CPS_DISABLED );
+        response.set_message( "implicit selection sync disabled by user" );
+        return response;
+    }
+
+    auto specToEntry =
+            []( const SelectionSpec& aSpec ) -> std::optional<wxString>
+            {
+                switch( aSpec.spec_case() )
+                {
+                case SelectionSpec::kFootprint:
+                    return wxT( "F" ) + EscapeString( wxString::FromUTF8( aSpec.footprint().reference() ),
+                                                      CTX_IPC );
+
+                case SelectionSpec::kPad:
+                    return wxT( "P" ) + EscapeString( wxString::FromUTF8( aSpec.pad().reference() ), CTX_IPC )
+                           + wxT( "/" ) + EscapeString( wxString::FromUTF8( aSpec.pad().number() ), CTX_IPC );
+
+                default:
+                    // Sheet paths are not something the sync-string parser handles yet.
+                    return std::nullopt;
+                }
+            };
+
+    std::vector<wxString> entries;
+    bool                  focusOnFirst = false;
+
+    if( aCtx.Request.has_focus_item() )
+    {
+        if( std::optional<wxString> entry = specToEntry( aCtx.Request.focus_item() ) )
+        {
+            entries.push_back( *entry );
+            focusOnFirst = true;
+        }
+    }
+
+    for( const SelectionSpec& spec : aCtx.Request.items() )
+    {
+        std::optional<wxString> entry = specToEntry( spec );
+
+        if( entry && std::find( entries.begin(), entries.end(), *entry ) == entries.end() )
+            entries.push_back( *entry );
+    }
+
+    if( entries.empty() )
+    {
+        response.set_status( CrossProbeStatus::CPS_INVALID );
+        response.set_message( "no selectable items in request" );
+        return response;
+    }
+
+    wxString syncStr;
+
+    for( const wxString& entry : entries )
+    {
+        if( !syncStr.empty() )
+            syncStr += wxT( "," );
+
+        syncStr += entry;
+    }
+
+    m_frame->SyncSelectionFromSpec( syncStr.ToStdString(), focusOnFirst );
+
+    response.set_status( CrossProbeStatus::CPS_OK );
+    return response;
+}
