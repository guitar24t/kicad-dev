# Inputs for the official AppImage recipe (kicad-appimage at KAI_REF), taken
# from its configs/release-10.0.5.json and .gitlab-ci.yml. The dependency
# images live in registry.gitlab.com/kicad/packaging/kicad-appimage (public;
# anonymous pulls); the tags are the ones the 10.0.5 release pipeline resolved
# to (base digest b9a701a2e77f4, EGL wx build, libraries dated 2026-07-21).
# Bumping KICAD_REF means re-deriving these from the matching release config.
BASE_TAG=latest
WX_TAG=wx-3e3ccab35c6cf37b989c1f1e3340a3eb731317e8-b9a701a2e77f4-egl
WXPYTHON_TAG=wxpython-a14508320d752b2c95ec1808c4c7bf128fff06ac-wx3e3ccab35c6c-b9a701a2e77f4-egl
OCCT_TAG=occt-V7_9_1-b9a701a2e77f4
NGSPICE_TAG=ngspice-45.2-b9a701a2e77f4
LIBS_TAG=libs-10.0.5-20260721
PACKAGES3D_TAG=packages3d-10.0.5-20260721
# AppImage-side patches from the release config (applied by the Dockerfile;
# they touch files disjoint from patches/kicad and apply cleanly on our tree).
KICAD_PATCHES="0001-Add-AppImage-to-platform-string.patch 0002-Remove-dirty-suffix-from-version.patch 0014-Allow-EGL-backend-in-AppImage-on-X11.patch 0015-Fix-intermittent-OpenGL-failure-on-GTK-realize-race.patch"
# AppImage runtime toolchain pins + checksums (kicad-appimage .gitlab-ci.yml).
SHARUN_VERSION=v0.8.1
URUNTIME_VERSION=v0.5.6
DWARFS_VERSION=v0.14.1
SHARUN_SHA256=18d970f56eca2c527ffd3993b161b6bc340055129db14b394a77cb67d8bbfff9
URUNTIME_SHA256=6416a112fac1e9983b1c0738cd140f17dc1205f515b9bdb36b4607ef98ee2a70
DWARFS_SHA256=f3a117fd6d5b7304944b199af7fdb8086a48c509ea2e9832255d8f9a54c98587
